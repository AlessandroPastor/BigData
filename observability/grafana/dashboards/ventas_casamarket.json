      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT TRIM(cliente) AS cliente, ROUND(SUM(total)::NUMERIC,2) AS ingresos FROM ventas WHERE cliente IS NOT NULL AND TRIM(cliente) != '' AND total > 0 GROUP BY TRIM(cliente) ORDER BY ingresos DESC LIMIT 10",
        "format": "table", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "currencyPEN" } },
