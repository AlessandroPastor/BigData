      "gridPos": { "x": 8, "y": 103, "w": 16, "h": 9 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT TRIM(cliente) AS cliente, segmento AS \"Segmento\", recencia_dias AS \"Recencia (dias)\", frecuencia AS \"# Compras\", ROUND(valor_monetario::NUMERIC,2) AS \"Total S/\", ROUND(ticket_promedio::NUMERIC,2) AS \"Ticket S/\" FROM segmentos_clientes ORDER BY valor_monetario DESC LIMIT 10",
        "format": "table", "refId": "A"
      }],
      "options": { "sortBy": [{ "displayName": "Total S/", "desc": true }] },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Total S/" }, "properties": [{ "id": "unit", "value": "currencyPEN" }] },
          { "matcher": { "id": "byName", "options": "Ticket S/" }, "properties": [{ "id": "unit", "value": "currencyPEN" }] },
          { "matcher": { "id": "byName", "options": "Segmento" }, "properties": [
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "mappings", "value": [
              { "type": "value", "options": { "VIP":       { "color": "gold",      "index": 0 } } },
              { "type": "value", "options": { "Regular":   { "color": "blue",      "index": 1 } } },
              { "type": "value", "options": { "En Riesgo": { "color": "dark-red",  "index": 2 } } }
            ]}
          ]}
        ]
      }
    },

