    { "id": 9, "type": "piechart", "title": "Ingresos por Categoria",
      "gridPos": { "x": 8, "y": 21, "w": 8, "h": 8 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT TRIM(categoria) AS categoria, ROUND(SUM(total)::NUMERIC,2) AS ingresos FROM ventas WHERE categoria IS NOT NULL AND TRIM(categoria) != '' AND total > 0 GROUP BY TRIM(categoria) ORDER BY ingresos DESC LIMIT 10",
        "format": "table", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "currencyPEN" } },
      "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right" } }
    },

    { "id": 10, "type": "barchart", "title": "Ingresos por Vendedor",
      "gridPos": { "x": 16, "y": 21, "w": 8, "h": 8 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT TRIM(vendedor) AS vendedor, ROUND(SUM(total)::NUMERIC,2) AS ingresos FROM ventas WHERE vendedor IS NOT NULL AND TRIM(vendedor) != '' AND total > 0 GROUP BY TRIM(vendedor) ORDER BY ingresos DESC LIMIT 10",
        "format": "table", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "currencyPEN" } },
      "options": { "orientation": "horizontal" }
    },

    { "id": 11, "type": "table", "title": "Ultimas ventas registradas",
      "gridPos": { "x": 0, "y": 29, "w": 24, "h": 8 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT fecha::TEXT AS fecha, COALESCE(hora, '-') AS hora, TRIM(producto) AS producto, TRIM(marca) AS marca, TRIM(categoria) AS categoria, cantidad, ROUND(total::NUMERIC,2) AS total, TRIM(cliente) AS cliente, TRIM(vendedor) AS vendedor FROM ventas WHERE fecha IS NOT NULL AND total > 0 ORDER BY procesado_ts DESC LIMIT 50",
        "format": "table", "refId": "A"
      }],
      "options": { "sortBy": [{ "displayName": "fecha", "desc": true }] }
    },

    { "id": 20, "type": "text", "title": "",
      "gridPos": { "x": 0, "y": 37, "w": 24, "h": 2 },
      "options": { "mode": "markdown", "content": "## Predicciones ML 2026 — Modelo original: sklearn LinearRegression | Referencia historica" }
    },

    { "id": 12, "type": "stat", "title": "Ingresos proyectados 2026 — Top 15 productos",
      "gridPos": { "x": 0, "y": 39, "w": 8, "h": 4 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
