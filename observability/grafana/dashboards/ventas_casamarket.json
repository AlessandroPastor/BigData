    { "id": 17, "type": "timeseries", "title": "Tendencia mensual proyectada 2026 — Top 4 productos (LinearRegression)",
      "gridPos": { "x": 0, "y": 53, "w": 24, "h": 9 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [
        { "rawSql": "SELECT mes::TIMESTAMPTZ AS time, ROUND(ingresos_pred::NUMERIC,2) AS value FROM predicciones_2026 WHERE TRIM(producto)=(SELECT TRIM(producto) FROM predicciones_2026 GROUP BY producto ORDER BY SUM(ingresos_pred) DESC LIMIT 1) ORDER BY mes", "format": "time_series", "refId": "A" },
        { "rawSql": "SELECT mes::TIMESTAMPTZ AS time, ROUND(ingresos_pred::NUMERIC,2) AS value FROM predicciones_2026 WHERE TRIM(producto)=(SELECT TRIM(producto) FROM predicciones_2026 GROUP BY producto ORDER BY SUM(ingresos_pred) DESC LIMIT 1 OFFSET 1) ORDER BY mes", "format": "time_series", "refId": "B" },
        { "rawSql": "SELECT mes::TIMESTAMPTZ AS time, ROUND(ingresos_pred::NUMERIC,2) AS value FROM predicciones_2026 WHERE TRIM(producto)=(SELECT TRIM(producto) FROM predicciones_2026 GROUP BY producto ORDER BY SUM(ingresos_pred) DESC LIMIT 1 OFFSET 2) ORDER BY mes", "format": "time_series", "refId": "C" },
        { "rawSql": "SELECT mes::TIMESTAMPTZ AS time, ROUND(ingresos_pred::NUMERIC,2) AS value FROM predicciones_2026 WHERE TRIM(producto)=(SELECT TRIM(producto) FROM predicciones_2026 GROUP BY producto ORDER BY SUM(ingresos_pred) DESC LIMIT 1 OFFSET 3) ORDER BY mes", "format": "time_series", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyPEN", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    { "id": 18, "type": "table", "title": "Tabla completa — Prediccion mensual por producto 2026",
      "gridPos": { "x": 0, "y": 62, "w": 24, "h": 9 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT TO_CHAR(mes, 'Mon YYYY') AS mes, TRIM(producto) AS producto, ROUND(ingresos_pred::NUMERIC,2) AS \"Proyectado S/\", ROUND(unidades_pred::NUMERIC,0) AS \"Unidades est.\", COALESCE(ROUND(ingresos_real::NUMERIC,2)::TEXT, '-') AS \"Real historico\" FROM predicciones_2026 ORDER BY mes, ingresos_pred DESC",
        "format": "table", "refId": "A"
      }],
      "options": { "sortBy": [{ "displayName": "Proyectado S/", "desc": true }] },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [{ "matcher": { "id": "byName", "options": "Proyectado S/" }, "properties": [{ "id": "unit", "value": "currencyPEN" }] }] }
    },

    { "id": 40, "type": "text", "title": "",
      "gridPos": { "x": 0, "y": 71, "w": 24, "h": 3 },
      "options": { "mode": "markdown", "content": "## ML Avanzado — GradientBoosting | IsolationForest | KMeans RFM\n\nModelos re-entrenados automaticamente cada **30 minutos** con todos los datos nuevos de ventas.\nPredicciones diarias con intervalo de confianza | Anomalias en tiempo real | Segmentacion de clientes" }
    },

    { "id": 30, "type": "barchart", "title": "Top 5 Productos — Prediccion proximos 7 dias (GradientBoosting)",
      "gridPos": { "x": 0, "y": 74, "w": 12, "h": 10 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT producto, ROUND(ingresos_pred_7d::NUMERIC,2) AS \"Ingresos Pred S/\", ROUND(ingresos_low_7d::NUMERIC,2) AS \"Banda Inferior\", ROUND(ingresos_high_7d::NUMERIC,2) AS \"Banda Superior\" FROM ranking_proximos_7d LIMIT 5",
        "format": "table", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "currencyPEN" } },
      "options": { "orientation": "horizontal", "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    { "id": 31, "type": "barchart", "title": "Ranking Vendedores — Prediccion proxima semana (GradientBoosting)",
      "gridPos": { "x": 12, "y": 74, "w": 12, "h": 10 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT vendedor, ROUND(ingresos_pred::NUMERIC,2) AS \"Ingresos Pred S/\", ROUND(ingresos_low::NUMERIC,2) AS \"Banda Inferior\", ROUND(ingresos_high::NUMERIC,2) AS \"Banda Superior\" FROM predicciones_vendedor WHERE semana_inicio = DATE_TRUNC('week', CURRENT_DATE + INTERVAL '7 days')::DATE ORDER BY ingresos_pred DESC LIMIT 10",
        "format": "table", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "currencyPEN" } },
      "options": { "orientation": "horizontal", "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    { "id": 32, "type": "timeseries", "title": "Predicho vs Real diario — Top 5 productos (con banda de confianza)",
      "gridPos": { "x": 0, "y": 84, "w": 24, "h": 10 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [
        {
          "rawSql": "SELECT fecha_pred::TIMESTAMPTZ AS time, ROUND(ingresos_pred::NUMERIC,2) AS \"Prediccion\", ROUND(ingresos_low::NUMERIC,2) AS \"Banda Inferior\", ROUND(ingresos_high::NUMERIC,2) AS \"Banda Superior\" FROM predicciones_diarias WHERE producto = (SELECT producto FROM ranking_proximos_7d WHERE ranking=1 LIMIT 1) ORDER BY fecha_pred",
          "format": "time_series", "refId": "A"
        },
        {
          "rawSql": "SELECT fecha::TIMESTAMPTZ AS time, ROUND(SUM(total)::NUMERIC,2) AS \"Real\" FROM ventas WHERE TRIM(producto)=(SELECT producto FROM ranking_proximos_7d WHERE ranking=1 LIMIT 1) AND total > 0 GROUP BY fecha ORDER BY fecha",
          "format": "time_series", "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyPEN", "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Banda Inferior" }, "properties": [{ "id": "custom.fillBelowTo", "value": "Banda Superior" }, { "id": "custom.lineWidth", "value": 0 }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "transparent" } }] },
          { "matcher": { "id": "byName", "options": "Banda Superior" }, "properties": [{ "id": "custom.fillOpacity", "value": 15 }, { "id": "custom.lineWidth", "value": 0 }] },
          { "matcher": { "id": "byName", "options": "Real" }, "properties": [{ "id": "custom.lineWidth", "value": 2 }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    { "id": 33, "type": "table", "title": "Alertas Streaming en Vivo — Estado del dia (Real vs Prediccion Diaria)",
      "gridPos": { "x": 0, "y": 94, "w": 14, "h": 9 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT producto, ROUND(ventas_hoy::NUMERIC,2) AS \"Ventas Hoy S/\", ROUND(prediccion_hoy::NUMERIC,2) AS \"Prediccion S/\", ROUND(pct_meta::NUMERIC,1) AS \"% Meta\", alerta AS \"Estado\" FROM estado_dia_actual ORDER BY pct_meta DESC LIMIT 20",
        "format": "table", "refId": "A"
      }],
      "options": { "sortBy": [{ "displayName": "% Meta", "desc": true }] },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Ventas Hoy S/" }, "properties": [{ "id": "unit", "value": "currencyPEN" }] },
          { "matcher": { "id": "byName", "options": "Prediccion S/" }, "properties": [{ "id": "unit", "value": "currencyPEN" }] },
          { "matcher": { "id": "byName", "options": "Estado" }, "properties": [
            { "id": "custom.displayMode", "value": "color-background" },
            { "id": "mappings", "value": [
              { "type": "value", "options": { "SOBRE_META": { "color": "green",      "index": 0 } } },
              { "type": "value", "options": { "EN_META":    { "color": "blue",       "index": 1 } } },
              { "type": "value", "options": { "EN_RIESGO":  { "color": "orange",     "index": 2 } } },
              { "type": "value", "options": { "BAJO_META":  { "color": "dark-red",   "index": 3 } } }
            ]}
          ]}
        ]
      }
    },

