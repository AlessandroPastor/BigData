    },

    { "id": 13, "type": "stat", "title": "Producto #1 proyectado — mayor ingreso anual 2026",
      "gridPos": { "x": 8, "y": 39, "w": 8, "h": 4 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{ "rawSql": "SELECT TRIM(producto) AS metric, ROUND(SUM(ingresos_pred)::NUMERIC,2) AS value FROM predicciones_2026 GROUP BY TRIM(producto) ORDER BY value DESC LIMIT 1", "format": "table", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "currencyPEN", "color": { "mode": "fixed", "fixedColor": "yellow" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "yellow", "value": null }] } } }
    },

    { "id": 14, "type": "stat", "title": "Producto #2 proyectado — mayor ingreso anual 2026",
      "gridPos": { "x": 16, "y": 39, "w": 8, "h": 4 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{ "rawSql": "SELECT TRIM(producto) AS metric, ROUND(SUM(ingresos_pred)::NUMERIC,2) AS value FROM predicciones_2026 GROUP BY TRIM(producto) ORDER BY value DESC LIMIT 1 OFFSET 1", "format": "table", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "currencyPEN", "color": { "mode": "fixed", "fixedColor": "light-orange" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "light-orange", "value": null }] } } }
    },

    { "id": 15, "type": "barchart", "title": "Top 10 Productos — Proyectado 2026 vs Real historico (S/)",
      "gridPos": { "x": 0, "y": 43, "w": 14, "h": 10 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT TRIM(producto) AS producto, ROUND(SUM(ingresos_pred)::NUMERIC,2) AS \"Proyectado 2026\", COALESCE(ROUND(SUM(ingresos_real)::NUMERIC,2), 0) AS \"Real historico\" FROM predicciones_2026 GROUP BY TRIM(producto) ORDER BY SUM(ingresos_pred) DESC LIMIT 10",
        "format": "table", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "currencyPEN" } },
      "options": { "orientation": "horizontal", "xTickLabelRotation": 0, "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    { "id": 16, "type": "piechart", "title": "Distribucion % proyectada 2026 por producto",
      "gridPos": { "x": 14, "y": 43, "w": 10, "h": 10 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT TRIM(producto) AS producto, ROUND(SUM(ingresos_pred)::NUMERIC,2) AS proyectado FROM predicciones_2026 GROUP BY TRIM(producto) ORDER BY proyectado DESC LIMIT 8",
        "format": "table", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "currencyPEN" } },
      "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right" } }
