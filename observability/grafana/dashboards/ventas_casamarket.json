      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT TRIM(marca) AS marca, ROUND(SUM(total)::NUMERIC,2) AS ingresos FROM ventas WHERE marca IS NOT NULL AND TRIM(marca) != '' AND total > 0 GROUP BY TRIM(marca) ORDER BY ingresos DESC LIMIT 12",
        "format": "table", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "currencyPEN" } },
      "options": { "pieType": "donut", "legend": { "displayMode": "table", "placement": "right" } }
