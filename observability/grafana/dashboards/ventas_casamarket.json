    { "id": 39, "type": "barchart", "title": "Ventas Promedio por Dia de Semana",
      "gridPos": { "x": 0, "y": 121, "w": 24, "h": 9 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT CASE EXTRACT(DOW FROM fecha) WHEN 0 THEN '0-Dom' WHEN 1 THEN '1-Lun' WHEN 2 THEN '2-Mar' WHEN 3 THEN '3-Mie' WHEN 4 THEN '4-Jue' WHEN 5 THEN '5-Vie' WHEN 6 THEN '6-Sab' END AS dia_semana, ROUND(SUM(total)::NUMERIC,2) AS \"Ingresos S/\", COUNT(*) AS \"Transacciones\" FROM ventas WHERE fecha IS NOT NULL AND total > 0 GROUP BY EXTRACT(DOW FROM fecha) ORDER BY EXTRACT(DOW FROM fecha)",
        "format": "table", "refId": "A"
      }],
      "fieldConfig": {
        "defaults": { "unit": "currencyPEN" },
        "overrides": [
