{
  "title": "CasaMarket — Ventas & Prediccion ML Avanzado",
  "uid": "casamarket-ventas",
  "schemaVersion": 38,
  "version": 5,
  "refresh": "1m",
  "time": { "from": "now-60d", "to": "now" },
  "timepicker": {},
  "panels": [

    { "id": 1, "type": "stat", "title": "Total Ingresos Reales (S/)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{ "rawSql": "SELECT ROUND(SUM(total)::NUMERIC,2) AS value FROM ventas WHERE total > 0", "format": "table", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "currencyPEN", "color": { "mode": "fixed", "fixedColor": "green" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } }
    },

    { "id": 2, "type": "stat", "title": "Transacciones registradas",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{ "rawSql": "SELECT COUNT(*) AS value FROM ventas WHERE total > 0", "format": "table", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } }
    },

    { "id": 3, "type": "stat", "title": "Productos unicos",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{ "rawSql": "SELECT COUNT(DISTINCT TRIM(producto)) AS value FROM ventas WHERE producto IS NOT NULL AND TRIM(producto) != ''", "format": "table", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] } } }
    },

    { "id": 4, "type": "stat", "title": "Clientes unicos",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{ "rawSql": "SELECT COUNT(DISTINCT TRIM(cliente)) AS value FROM ventas WHERE cliente IS NOT NULL AND TRIM(cliente) != ''", "format": "table", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] } } }
    },

    { "id": 5, "type": "timeseries", "title": "Ingresos diarios historicos (S/)",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT fecha::TIMESTAMPTZ AS time, ROUND(SUM(total)::NUMERIC,2) AS \"Ingresos S/\" FROM ventas WHERE fecha IS NOT NULL AND total > 0 GROUP BY fecha ORDER BY fecha",
        "format": "time_series", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "currencyPEN", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "single" } }
    },

    { "id": 6, "type": "barchart", "title": "Top 15 Productos por Ingresos",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 9 },
      "datasource": { "type": "postgres", "uid": "casamarket-pg" },
      "targets": [{
        "rawSql": "SELECT TRIM(producto) AS producto, ROUND(SUM(total)::NUMERIC,2) AS ingresos FROM ventas WHERE producto IS NOT NULL AND TRIM(producto) != '' AND total > 0 GROUP BY TRIM(producto) ORDER BY ingresos DESC LIMIT 15",
        "format": "table", "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "currencyPEN" } },
      "options": { "orientation": "horizontal", "xTickLabelRotation": 0 }
