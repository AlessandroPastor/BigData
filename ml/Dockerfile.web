FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi==0.115.0 \
    uvicorn[standard]==0.30.6 \
    sqlalchemy==2.0.36 \
    psycopg2-binary==2.9.9 \
    pandas==2.2.3 \
    numpy==1.26.4 \
    scikit-learn==1.5.2

COPY ml/ ./ml/

EXPOSE 8000

CMD ["uvicorn", "ml.app:app", "--host", "0.0.0.0", "--port", "8000"]
